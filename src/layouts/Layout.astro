---
import '../styles/global.css';
import TopNavbar from '../components/TopNavbar.astro';
import BottomStatusBar from '../components/BottomStatusBar.astro';

interface Props {
	title?: string;
	lang?: string;
}

const { title = 'Seoyedoum', lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<TopNavbar />
		<div class="page-content">
			<slot />
		</div>
		<BottomStatusBar />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		display: flex;
		flex-direction: column;
		height: 100dvh;
		overflow: hidden;
	}

	.page-content {
		position: relative;
		flex: 1;
		min-height: 0;
		overflow: auto;
		isolation: isolate;
	}
</style>
