---
import Layout from '../layouts/Layout.astro';

const metrics = [
	['characters', '공백 포함'],
	['without-spaces', '공백 제외'],
	['words', '단어 수'],
];
---

<Layout title="글자 수 세기 | Seoyedoum" lang="ko">
	<main class="mx-auto flex w-full max-w-5xl flex-col gap-8 px-4 py-8 sm:px-8 sm:py-12">
		<header class="space-y-2">
			<h1 class="text-3xl font-bold tracking-tight">글자 수 세기</h1>
			<p class="text-sm leading-6 text-muted-foreground">글을 입력하거나 붙여 넣으면 글자 수를 바로 확인할 수 있습니다.</p>
		</header>

		<dl class="grid grid-cols-3 gap-3 sm:gap-4" aria-live="polite" aria-atomic="true">
			{metrics.map(([id, label]) => (
				<div class="rounded-xl border bg-card p-4 sm:p-6">
					<dt class="text-xs text-muted-foreground sm:text-sm">{label}</dt>
					<dd id={id} class="mt-3 break-all text-3xl font-semibold tabular-nums sm:text-4xl">0</dd>
				</div>
			))}
		</dl>

		<section class="overflow-hidden rounded-xl border bg-card" aria-labelledby="input-label">
			<div class="flex items-center justify-between border-b px-4 py-3">
				<label id="input-label" for="count-text" class="text-sm font-medium">텍스트 입력</label>
				<button id="clear-text" type="button" disabled class="rounded-md px-3 py-1.5 text-sm text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:outline-2 disabled:cursor-not-allowed disabled:opacity-40">전체 지우기</button>
			</div>
			<textarea id="count-text" aria-describedby="count-help" placeholder="여기에 글을 입력해 주세요." class="block min-h-72 w-full resize-y bg-transparent p-4 text-base leading-8 outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring sm:min-h-96 sm:p-6"></textarea>
			<div class="border-t bg-muted/30 px-4 py-3 text-xs leading-5 text-muted-foreground">입력한 내용은 서버에 전송하거나 저장하지 않습니다.</div>
		</section>

		<p id="count-help" class="text-xs leading-6 text-muted-foreground">
			공백 포함은 띄어쓰기·탭·줄바꿈을 포함하며, 공백 제외는 이를 모두 제외합니다.<br />
			이모지와 결합 문자는 화면에 보이는 한 글자로 세며, 단어는 공백으로 구분합니다.
		</p>
		<noscript><p>실시간 글자 수 계산을 사용하려면 JavaScript를 활성화해 주세요.</p></noscript>
	</main>
</Layout>

<script>
	import { countText } from '../lib/countText';

	const input = document.querySelector<HTMLTextAreaElement>('#count-text')!;
	const clear = document.querySelector<HTMLButtonElement>('#clear-text')!;
	const characters = document.querySelector<HTMLElement>('#characters')!;
	const withoutSpaces = document.querySelector<HTMLElement>('#without-spaces')!;
	const words = document.querySelector<HTMLElement>('#words')!;
	const format = new Intl.NumberFormat('ko-KR');

	function updateCounts() {
		const counts = countText(input.value);
		characters.textContent = format.format(counts.characters);
		withoutSpaces.textContent = format.format(counts.withoutSpaces);
		words.textContent = format.format(counts.words);
		clear.disabled = input.value.length === 0;
	}

	input.addEventListener('input', updateCounts);
	clear.addEventListener('click', () => {
		input.value = '';
		updateCounts();
		input.focus();
	});
	window.addEventListener('pageshow', updateCounts);
	updateCounts();
</script>
